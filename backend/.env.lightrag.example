# Set these variables in the backend process environment; no auto dotenv load.
HCI_LIGHTRAG_URL=http://127.0.0.1:9622
HCI_LIGHTRAG_WORKSPACE=hci_comparison_a
HCI_LIGHTRAG_API_KEY=replace-with-same-local-server-key
HCI_LIGHTRAG_TIMEOUT=10
HCI_LIGHTRAG_POLL_INTERVAL=0.5
HCI_LIGHTRAG_TOP_K=8
HCI_LIGHTRAG_MAX_TOKENS=4000
HCI_LIGHTRAG_MAX_CHUNKS=100
HCI_LIGHTRAG_MAX_CHUNK_CHARS=12000
HCI_LIGHTRAG_MAX_RESPONSE_BYTES=2000000
HCI_LIGHTRAG_MODE=mix
# Explicit consent for ingestion + targeted deletion in a disposable server.
# HCI_LIGHTRAG_REAL_TEST=1
# Optional SECOND dedicated server for concurrency scenario.
# HCI_LIGHTRAG_URL_2=http://127.0.0.1:9623
# HCI_LIGHTRAG_WORKSPACE_2=hci_comparison_b
# HCI_LIGHTRAG_API_KEY_2=replace-with-second-server-key
